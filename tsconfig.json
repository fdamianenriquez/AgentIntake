{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "react", "react-dom"],
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "cli/**/*.ts",
    "server/**/*.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "demo/**/*.ts",
    "demo/**/*.tsx",
    "studio/**/*.ts",
    "studio/**/*.tsx",
    "vitest.setup.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
