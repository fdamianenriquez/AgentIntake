{
  "name": "agent-intake",
  "version": "1.0.0",
  "description": "Turns an OpenAPI spec into a single, AI-orchestrated, multi-step form wizard.",
  "license": "MIT",
  "author": "Damian Enriquez",
  "keywords": [
    "openapi",
    "form",
    "wizard",
    "multi-step",
    "react",
    "llm",
    "structured-output",
    "schema-driven"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fdamianenriquez/AgentIntake.git"
  },
  "homepage": "https://github.com/fdamianenriquez/AgentIntake#readme",
  "bugs": {
    "url": "https://github.com/fdamianenriquez/AgentIntake/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/packages/react-agent-intake/src/index.d.ts",
      "import": "./dist/packages/react-agent-intake/src/index.js"
    },
    "./server": {
      "types": "./dist/server/src/public.d.ts",
      "import": "./dist/server/src/public.js"
    },
    "./schemas/agentintake.config.schema.json": "./schemas/agentintake.config.schema.json",
    "./package.json": "./package.json"
  },
  "types": "./dist/packages/react-agent-intake/src/index.d.ts",
  "files": [
    "dist/cli/",
    "dist/server/",
    "dist/packages/",
    "studio/",
    "packages/react-agent-intake/src/",
    "server/src/providers.ts",
    "evals/",
    "schemas/",
    "CHANGELOG.md",
    "!**/*.test.*",
    "!**/__snapshots__/",
    "!**/__fixtures__/",
    "!dist/cli/**/*.d.ts.map",
    "!dist/server/**/*.d.ts.map",
    "!dist/cli/**/*.d.ts",
    "!dist/server/**/*.d.ts",
    "dist/server/src/public.d.ts",
    "dist/server/src/app.d.ts",
    "dist/server/src/config.d.ts",
    "!dist/server/src/index.js",
    "!dist/server/src/exampleFlow.js"
  ],
  "bin": {
    "agent-intake": "./dist/cli/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "start": "node dist/server/src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:package": "publint --pack npm && attw --pack . --profile esm-only",
    "size": "size-limit",
    "smoke-test": "node scripts/smoke-test-package.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/google": "^4.0.93",
    "@ai-sdk/openai": "^4.0.91",
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/express": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "ai": "^7.0.137",
    "commander": "^15.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "js-yaml": "^5.4.3",
    "openapi-types": "^12.1.3",
    "vite": "^8.3.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cors": "^2.8.19",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.2.0",
    "supertest": "^7.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
