{
  "name": "agent-intake",
  "version": "1.6.0",
  "description": "Turns an OpenAPI spec into a single, AI-orchestrated, multi-step form wizard.",
  "license": "MIT",
  "keywords": [
    "openapi",
    "form",
    "wizard",
    "multi-step",
    "react",
    "llm",
    "structured-output",
    "schema-driven"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fdamianenriquez/AgentIntake.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "private": true,
  "type": "module",
  "files": [
    "dist/cli/",
    "dist/server/",
    "dist/packages/",
    "studio/",
    "packages/react-agent-intake/src/",
    "server/src/providers.ts",
    "evals/",
    "schemas/",
    "CHANGELOG.md",
    "!**/*.test.*",
    "!**/__snapshots__/",
    "!**/__fixtures__/"
  ],
  "bin": {
    "agent-intake": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.60",
    "@ai-sdk/google": "^4.0.77",
    "@ai-sdk/openai": "^4.0.72",
    "@apidevtools/swagger-parser": "^13.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ai": "^7.0.111",
    "commander": "^15.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "js-yaml": "^5.4.2",
    "openapi-types": "^12.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "supertest": "^7.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.1"
  }
}
