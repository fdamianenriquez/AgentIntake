# Which LLM provider server/src/llmClient.ts should use.
# One of: anthropic | openai | google | openrouter
# Defaults to "anthropic" if unset.
LLM_PROVIDER=anthropic

# Provider-specific model name. Optional -- each provider has a default.
# LLM_MODEL=claude-haiku-5-5

# The API key for whichever LLM_PROVIDER you selected above. It must be a key
# for that provider -- the same variable is used for all of them.
LLM_API_KEY=

# Note on openrouter: https://openrouter.ai is not one of the three providers
# this project targets, but its API is OpenAI-compatible, so it's supported as a
# fourth option via the same @ai-sdk/openai client with a different base URL.
# Handy for development: LLM_MODEL defaults to a free-tier OpenRouter model
# when LLM_PROVIDER=openrouter and LLM_MODEL is unset.

# Origins allowed to call the runtime server from a browser, comma-separated
# (e.g. https://app.example.com). Unset, every origin is allowed -- fine for
# the local demo, not for a deployed server -- and a warning is logged.
# AGENTINTAKE_CORS_ORIGINS=

# Author guidance config file (see README "Author guidance"). Default:
# agentintake.config.json in the working directory; a missing file at a path
# set here is an error.
# AGENTINTAKE_CONFIG=agentintake.config.json

# A directory of flow.json files whose guidance the runtime server trusts; while
# set, guidance sent by the browser is never used (README "Trust model").
# AGENTINTAKE_FLOWS_DIR=flows

# error | warn (default) | info | debug. At debug, each LLM call logs one line
# with its versions, a short guidance hash, the outcome and the duration --
# never guidance text or user data.
# AGENTINTAKE_LOG_LEVEL=warn
