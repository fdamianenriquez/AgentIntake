# ---------------------------------------------------------------------------
# Model provider configuration
#
# AI_PROVIDER selects the provider adapter:
#   anthropic          -> Claude (default, SDK-based)
#   openai             -> OpenAI (OpenAI-compatible API)
#   openrouter         -> OpenRouter (OpenAI-compatible API, many free models)
#   openai-compatible  -> any OpenAI-compatible endpoint (Groq, Together,
#                         vLLM, Ollama at http://localhost:11434/v1, ...)
# ---------------------------------------------------------------------------
AI_PROVIDER=anthropic

# The provider's API key. ANTHROPIC_API_KEY below is used as a fallback when
# AI_API_KEY is not set (keeps existing setups working).
AI_API_KEY=

# Model identifier. Defaults per provider:
#   anthropic: claude-3-5-haiku-latest | openai: gpt-4o-mini
#   openrouter: openrouter/auto | openai-compatible: REQUIRED (no default)
AI_MODEL=

# Optional base URL override for the OpenAI-compatible adapters.
# Defaults: openai=https://api.openai.com/v1, openrouter=https://openrouter.ai/api/v1,
#           openai-compatible=http://localhost:11434/v1
AI_BASE_URL=

# ---------------------------------------------------------------------------
# Legacy names (still supported)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

PORT=4000
